{
  "name": "folio-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor (take-home assignment)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "marked": "18.3.0",
    "multer": "2.5.0",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "turndown": "7.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
